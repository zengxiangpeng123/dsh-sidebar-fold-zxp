{
  "name": "dsh-sidebar-fold-zxp",
  "version": "0.1.0",
  "description": "Fold the plugin entries in the DSH sidebar into a single row, so workspaces and sessions get the height back.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "fold",
    "collapse"
  ],
  "license": "MIT"
}
