{
  "name": "dsh-sidebar-fold-zxp",
  "version": "0.8.0",
  "description": "把 DSH 左侧那排插件入口折起来、按组归类、按你定的顺序排。Fold the sidebar plugin entries into collapsible groups you order yourself.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengxiangpeng123/dsh-sidebar-fold-zxp.git"
  },
  "homepage": "https://github.com/zengxiangpeng123/dsh-sidebar-fold-zxp#readme",
  "bugs": {
    "url": "https://github.com/zengxiangpeng123/dsh-sidebar-fold-zxp/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "fold",
    "collapse"
  ],
  "license": "MIT"
}
